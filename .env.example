# Tên Server trong SSMS (ví dụ: localhost\SQLEXPRESS hoặc .)
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=QuanLyBaoTri
DB_DRIVER=ODBC Driver 17 for SQL Server

# windows: đăng nhập bằng tài khoản Windows (thường dễ hơn để học)
# sql: đăng nhập bằng SQL Server Authentication
DB_AUTH=windows
# DB_USER=sa
# DB_PASS=thay-mat-khau

# Thay bằng chuỗi bí mật đủ dài, khác nhau ở mỗi máy
SECRET_KEY=thay-chuoi-ngau-nhien-truoc-khi-chay
